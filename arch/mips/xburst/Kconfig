menuconfig SOC_TYPE
	tristate "SOC type"
	depends on MACH_XBURST
	default y

if SOC_TYPE
choice
	prompt "SOC types"
	depends on MACH_XBURST
	default SOC_T23

config SOC_T23
	bool "t23"
	select IRQ_INGENIC_CPU
	select CLK_T23
	select INGENIC_INTC
	select PINCTRL
	select PINCTRL_INGENIC
	select CLKSRC_OF
	select CLKDEV_LOOKUP
	select CLKSRC_INGENIC_SYS_OST

endchoice


choice
	prompt "device tree select"
	default DT_NONE
config DT_NONE

if SOC_T23
source "arch/mips/xburst/soc-t23/Kconfig.DT"
endif

endchoice

config INGENIC_BUILTIN_DTB
	select BUILTIN_DTB
	depends on MACH_XBURST
	bool "Ingenic Device Tree build into Kernel."
	default y

choice
	prompt "device tree select"
	default DT_NONE
config DT_NONE

if SOC_T23
source "arch/mips/xburst/soc-t23/Kconfig.DT"
endif

endchoice

config RAW_BOOT
	bool "Raw Boot Kernel"
	select BOOT_RAW
	default n

config KERNEL_4_4_94
	bool "kernel version 4.4.94"
    default y

config EXTAL_CLOCK
	depends on MACH_XBURST
	int "extal clock in MHz"
	default 24

config INGENIC_GPT_CHECK
	depends on MACH_XBURST
	bool "The physical space is larger than the virtual space"
	default y

config SUSPEND_TEST
	bool "auto suspend test"
	default n

config SUSPEND_ALARM_TIME
	int "suspend alarm time(second)"
	depends on SUSPEND_TEST
	default 2

config XBURST_MXUV2
	bool
	default n

endif
