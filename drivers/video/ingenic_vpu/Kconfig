#
# jz_vpu configuration
#
menuconfig JZ_VPU
    bool "jz vpu driver"
    default y
    help
        jz vpu platform dirver

if JZ_VPU
config CHANNEL_NODE_NUM
    int "channel node number"
    default 16

config VPU_NODE_NUM
    depends on JZ_VPU
    int "vpu node number"
    default 2

config JZ_VPU_KERN_ENCODE
    bool "jz vpu kernel encode"
    default n

if JZ_VPU_KERN_ENCODE
config JZ_VPU_KERN_ENCODE_H264
    bool "jz vpu h264 kernel encode"
    default y

config JZ_VPU_KERN_ENCODE_H265
    bool "jz vpu h265 kernel encode"
    default y

config JZ_VPU_KERN_ENCODE_JPEG
    bool "jz vpu jpeg kernel encode"
    default y
endif

source "drivers/video/ingenic_vpu/helix/Kconfig"
source "drivers/video/ingenic_vpu/radix/Kconfig"

endif
